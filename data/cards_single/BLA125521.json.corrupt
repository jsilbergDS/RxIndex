  "card": "{\n  \"pivotal_trials\": [\n    {\n      \"trial_name\": {\n        \"text\": \"Trial RHAZ (I1F-MC-RHAZ; labeled Trial 1)\",\n        \"citations\": [\n          {\"quote\": \"6.1.\\tI1F-MC-RHAZ (b)\\t54\", \"doc_id\": \"7445eb1f-5561-5028-b19a-e9875aee9fef\", \"line\": 251},\n          {\"quote\": \"The ixekizumab phase 3 RHAZ study was a multicenter, randomized, double-blind, placebo-controlled and parallel group outpatient study.\", \"doc_id\": \"7445eb1f-5561-5028-b19a-e9875aee9fef\", \"line\": 29}\n        ]\n      },\n      \"nct\": {\"text\": \"Not stated in reviewed documents\", \"citations\": [{\"quote\": \"The ixekizumab phase 3 RHAZ study was a multicenter, randomized, double-blind, placebo-controlled and parallel group outpatient study.\", \"doc_id\": \"7445eb1f-5561-5028-b19a-e9875aee9fef\", \"line\": 29}]},\n      \"phase\": {\"text\": \"Phase 3\", \"citations\": [{\"quote\": \"The applicant submitted data from three randomized, multicenter, placebo-controlled, parallel-group, pivotal Phase 3 trials (Trials RHAZ, RHBA, and RHBC).\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 12}]},\n      \"design\": {\"text\": \"Multicenter, randomized, double-blind, placebo-controlled, parallel-group trial with a 12-week induction period followed by a randomized maintenance period\", \"citations\": [{\"quote\": \"All three are multicenter, randomized, double-blind, placebo-controlled, parallel-group, Phase 3 trials evaluating the safety and efficacy of TALTZ for the treatment of moderate-to-severe plaque psoriasis.\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 44}]},\n      \"population\": {\"text\": \"Adults \u226518 years with plaque psoriasis, \u226510% BSA involvement, sPGA \u22653, and PASI \u226512\", \"citations\": [{\"quote\": \"The trials enrolled subjects 18 years of age and older who had plaque psoriasis with Psoriasis Area and Severity Index (PASI) score \\\\ge 12, Static Physician's Global Assessment (sPGA) score of at least 3 (moderate) and body surface area (BSA) in\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 12}]},\n      \"endpoint\": {\"text\": \"Co-primary: proportion achieving sPGA 0 or 1 (\u22652-point improvement) and proportion achieving PASI-75, both at Week 12\", \"citations\": [{\"quote\": \"The co-primary efficacy endpoints were the proportion of subjects achieving a sPGA score of 0 (clear) or 1 (minimal) with at least a 2-point improvement from baseline at Week 12 and the proportion of subjects achieving a \\\\ge 75% improvement in PASI (PASI-75) from baseline at Week 12.\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 13}]},\n      \"n\": {\"text\": \"N=1296 (TALTZ Q2W 433, placebo 431)\", \"citations\": [{\"quote\": \"RHAZ\\n(N=1296)\\tRHBA\\n(N=1224)\\tRHBC\\n(N=1346)\\tTotal\\n(N=3866)\\tAge (Years)\", \"doc_id\": \"7445eb1f-5561-5028-b19a-e9875aee9fef\", \"line\": 744}, {\"quote\": \"TALTZ 80 mg\\tPlacebo\\nN=431\\tTALTZ 80 mg\\tPlacebo\\nN=168\\tTALTZ 80 mg\\tPlacebo\\nN=193\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 15}, {\"quote\": \"RHAZi\\t433\\t432\\t431\\t1296\", \"doc_id\": \"7445eb1f-5561-5028-b19a-e9875aee9fef\", \"line\": 874}]},\n      \"result\": {\"text\": \"sPGA 0/1 at Week 12: 82% TALTZ Q2W vs 3% placebo; PASI-75: 89% vs 4%\", \"citations\": [{\"quote\": \"sPGA of 0 or 1\\t82%\\t76%\\t3%\\t83%\\t73%\\t2%\\t81%\\t75%\\t7%\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 15}, {\"quote\": \"PASI-75\\t89%\\t83%\\t4%\\t90%\\t78%\\t2%\\t87%\\t84%\\t7%\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 15}]}\n    },\n    {\n      \"trial_name\": {\n        \"text\": \"Trial RHBA (I1F-MC-RHBA; labeled Trial 2)\",\n        \"citations\": [\n          {\"quote\": \"6.2.\\tI1F-MC-RHBA (b)\\t63\", \"doc_id\": \"7445eb1f-5561-5028-b19a-e9875aee9fef\", \"line\": 251}\n        ]\n      },\n      \"nct\": {\"text\": \"Not stated in reviewed documents\", \"citations\": [{\"quote\": \"Three phase 3 clinical trials (RHAZ, RHBA, and RHBC) of ixekizumab \\u2013 Itch NRS\", \"doc_id\": \"7445eb1f-5561-5028-b19a-e9875aee9fef\", \"line\": 93}]},\n      \"phase\": {\"text\": \"Phase 3\", \"citations\": [{\"quote\": \"The applicant submitted data from three randomized, multicenter, placebo-controlled, parallel-group, pivotal Phase 3 trials (Trials RHAZ, RHBA, and RHBC).\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 12}]},\n      \"design\": {\"text\": \"Multicenter, randomized, double-blind, placebo-controlled, parallel-group trial that also included etanercept as an active comparator\", \"citations\": [{\"quote\": \"Trials RHBA and RHBC included etanercept as an active comparator.\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 17}]},\n      \"population\": {\"text\": \"Adults \u226518 years with plaque psoriasis, \u226510% BSA, sPGA \u22653, PASI \u226512\", \"citations\": [{\"quote\": \"The trials enrolled subjects 18 years of age and older who had plaque psoriasis with Psoriasis Area and Severity Index (PASI) score \\\\ge 12, Static Physician's Global Assessment (sPGA) score of at least 3 (moderate) and body surface area (BSA) in\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 12}]},\n      \"endpoint\": {\"text\": \"Co-primary: sPGA 0 or 1 and PASI-75 at Week 12\", \"citations\": [{\"quote\": \"The co-primary efficacy endpoints were the proportion of subjects achieving a sPGA score of 0 (clear) or 1 (minimal) with at least a 2-point improvement from baseline at Week 12 and the proportion of subjects achieving a \\\\ge 75% improvement in PASI (PASI-75) from baseline at Week 12.\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 13}]},\n      \"n\": {\"text\": \"N=1224 (TALTZ Q2W 351, placebo 168)\", \"citations\": [{\"quote\": \"RHAZ\\n(N=1296)\\tRHBA\\n(N=1224)\\tRHBC\\n(N=1346)\\tTotal\\n(N=3866)\\tAge (Years)\", \"doc_id\": \"7445eb1f-5561-5028-b19a-e9875aee9fef\", \"line\": 744}, {\"quote\": \"RHBAi\\t351\\t347\\t358\\t168\\t1224\", \"doc_id\": \"7445eb1f-5561-5028-b19a-e9875aee9fef\", \"line\": 874}]},\n      \"result\": {\"text\": \"sPGA 0/1 at Week 12: 83% TALTZ Q2W vs 2% placebo; PASI-75: 90% vs 2%\", \"citations\": [{\"quote\": \"sPGA of 0 or 1\\t82%\\t76%\\t3%\\t83%\\t73%\\t2%\\t81%\\t75%\\t7%\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 15}, {\"quote\": \"PASI-75\\t89%\\t83%\\t4%\\t90%\\t78%\\t2%\\t87%\\t84%\\t7%\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 15}]}\n    },\n    {\n      \"trial_name\": {\n        \"text\": \"Trial RHBC (I1F-MC-RHBC; labeled Trial 3)\",\n        \"citations\": [\n          {\"quote\": \"6.3.\\tI1F-MC-RHBC (b)\\t70\", \"doc_id\": \"7445eb1f-5561-5028-b19a-e9875aee9fef\", \"line\": 251}\n        ]\n      },\n      \"nct\": {\"text\": \"Not stated in reviewed documents\", \"citations\": [{\"quote\": \"Three phase 3 clinical trials (RHAZ, RHBA, and RHBC) of ixekizumab \\u2013 Itch NRS\", \"doc_id\": \"7445eb1f-5561-5028-b19a-e9875aee9fef\", \"line\": 93}]},\n      \"phase\": {\"text\": \"Phase 3\", \"citations\": [{\"quote\": \"The applicant submitted data from three randomized, multicenter, placebo-controlled, parallel-group, pivotal Phase 3 trials (Trials RHAZ, RHBA, and RHBC).\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 12}]},\n      \"design\": {\"text\": \"Multicenter, randomized, double-blind, placebo-controlled, parallel-group trial that also included etanercept as an active comparator\", \"citations\": [{\"quote\": \"Trials RHBA and RHBC included etanercept as an active comparator.\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 17}]},\n      \"population\": {\"text\": \"Adults \u226518 years with plaque psoriasis, \u226510% BSA, sPGA \u22653, PASI \u226512\", \"citations\": [{\"quote\": \"The trials enrolled subjects 18 years of age and older who had plaque psoriasis with Psoriasis Area and Severity Index (PASI) score \\\\ge 12, Static Physician's Global Assessment (sPGA) score of at least 3 (moderate) and body surface area (BSA) in\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 12}]},\n      \"endpoint\": {\"text\": \"Co-primary: sPGA 0 or 1 and PASI-75 at Week 12\", \"citations\": [{\"quote\": \"The co-primary efficacy endpoints were the proportion of subjects achieving a sPGA score of 0 (clear) or 1 (minimal) with at least a 2-point improvement from baseline at Week 12 and the proportion of subjects achieving a \\\\ge 75% improvement in PASI (PASI-75) from baseline at Week 12.\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 13}]},\n      \"n\": {\"text\": \"N=1346 (TALTZ Q2W 385, placebo 193)\", \"citations\": [{\"quote\": \"RHAZ\\n(N=1296)\\tRHBA\\n(N=1224)\\tRHBC\\n(N=1346)\\tTotal\\n(N=3866)\\tAge (Years)\", \"doc_id\": \"7445eb1f-5561-5028-b19a-e9875aee9fef\", \"line\": 744}, {\"quote\": \"RHBCi\\t385\\t386\\t382\\t193\\t1346\", \"doc_id\": \"7445eb1f-5561-5028-b19a-e9875aee9fef\", \"line\": 874}]},\n      \"result\": {\"text\": \"sPGA 0/1 at Week 12: 81% TALTZ Q2W vs 7% placebo; PASI-75: 87% vs 7%\", \"citations\": [{\"quote\": \"sPGA of 0 or 1\\t82%\\t76%\\t3%\\t83%\\t73%\\t2%\\t81%\\t75%\\t7%\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 15}, {\"quote\": \"PASI-75\\t89%\\t83%\\t4%\\t90%\\t78%\\t2%\\t87%\\t84%\\t7%\", \"doc_id\": \"e2106505-63dc-556e-8a21-e363d862a6ff\", \"line\": 15}]}\n    }\n  ],\n  \"indication\": {\n    \"text\": \"TALTZ is indicated for the treatment of adults with moderate-to-severe plaque psoriasis who are candidates for systemic therapy or phototherapy.\",\n    \"citations\": [{\"quote\": \"TALTZ\\u2122 is indicated for the treatment of adults with moderate-to-severe plaque psoriasis who are candidates for systemic therapy or phototherapy.\", \"doc_id\": \"89fe68a5-cacf-5e62-a9d4-4639f57d8c63\", \"line\": 49}]\n  },\n  \"target_moa\": {\n    \"text\": \"Ixekizumab is a humanized IgG4 monoclonal antibody that binds specifically to interleukin-17A (IL-17A), a pro-inflammatory cytokine, and does not bind other IL-17 family members.\",\n    \"citations\": [\n      {\"quote\": \"TALTZ (ixekizumab) for injection is a recombinant humanized IgG4 monoclonal antibody specific for IL-17A, a pro-inflammatory cytokine involved in immune responses.\", \"doc_id\": \"65597e08-4ad8-5b94-8828-07e88ecce742\", \"line\": 44},\n      {\"quote\": \"Ixekizumab was found to bind specifically to human IL-17A but not with the other members of the IL-17 family (IL-17B through IL-17F).\", \"doc_id\": \"65597e08-4ad8-5b94-8828-07e88ecce742\", \"line\": 37}\n    ]\n  },\n  \"modality\": {\n    \"text\": \"mAb (humanized IgG4 monoclonal antibody)\",\n    \"citations\": [{\"quote\": \"The drug substance, ixekizumab, is a humanized IgG4 \\\\kappa monoclonal antibody that binds IL-17A and is expressed in a recombinant CHOK1SV cell line.\", \"doc_id\": \"65597e08-4ad8-5b94-8828-07e88ecce742\", \"line\": 25}]\n  },\n  \"key_safety\": {\n    \"text\": \"Most common adverse reactions (\u22651%): injection site reactions (17% vs 3% placebo), upper respiratory tract infections (14% vs 13%), nausea (2%), and tinea infections (2%). TALTZ increased infection rate (27% vs 23% placebo).\",\n    \"citations\": [\n      {\"quote\": \"Injection site reactions\\t196 (17)\\t32 (11)\\t26 (3)\", \"doc_id\": \"89fe68a5-cacf-5e62-a9d4-4639f57d8c63\", \"line\": 94},\n      {\"quote\": \"Upper respiratory tract infectionsa\\t163 (14)\\t23 (8)\\t101 (13)\", \"doc_id\": \"89fe68a5-cacf-5e62-a9d4-4639f57d8c63\", \"line\": 94},\n      {\"quote\": \"Nausea\\t23 (2)\\t1 (<1)\\t5 (1)\", \"doc_id\": \"89fe68a5-cacf-5e62-a9d4-4639f57d8c63\", \"line\": 94},\n      {\"quote\": \"Tinea infections\\t17 (2)\\t0\\t1 (<1)\", \"doc_id\": \"89fe68a5-cacf-5e62-a9d4-4639f57d8c63\", \"line\": 94},\n      {\"quote\": \"In clinical trials, the TALTZ group had a higher rate of infections than the placebo group (27% vs. 23%).\", \"doc_id\": \"89fe68a5-cacf-5e62-a9d4-4639f57d8c63\", \"line\": 73}\n    ]\n  },\n  \"boxed_warning\": {\"present\": false, \"detail\": null},\n  \"rems\": {\"present\": false, \"detail\": null},\n  \"companion_dx\": {\"present\": false, \"detail\": null},\n  \"advisory_committee\": {\n    \"convened\": false,\n    \"vote\": {\n      \"text\": \"No advisory committee meeting was held, as the application for this second-in-class IL-17A antagonist did not present novel issues meriting AC input.\",\n      \"citations\": [{\"quote\": \"No advisory committee meeting was held, as the application for this second-in-class IL17A antagonist did not present novel issues which merited advisory committee input.\", \"doc_id\": \"65597e08-4ad8-5b94-8828-07e88ecce742\", \"line\": 88}]\n    }\n  },\n  \"first_cycle_approval\": {\n    \"value\": true,\n    \"detail\": {\n      \"text\": \"Approved on first cycle; BLA received March 23, 2015 with PDUFA goal date March 23, 2016; no prior CRL noted.\",\n      \"citations\": [{\"quote\": \"Date of Submission\\t23 Mar 2015\\nPDUFA Goal Date\\t23 Mar 2016\", \"doc_id\": \"65597e08-4ad8-5b94-8828-07e88ecce742\", \"line\": 5}]\n    }\n  },\n  \"receipt_date\": {\n    \"text\": \"03/23/2015\",\n    \"citations\": [{\"quote\": \"Please refer to your Biologics License Application (BLA) dated and received March 23, 2015, and your amendments, submitted under section 351(a) of the Public Health Service Act for TALTZ (ixekizumab) injection prefilled syringe and autoinjector, 80 mg/mL.\", \"doc_id\": \"b49ca5c9-0ae2-566d-8cbd-854ad39c1efc\", \"line\": 5}]\n  },\n  \"post_marketing\": [\n    {\"type\": \"PMR\", \"requirement\": {\"text\": \"3049-1: Conduct a dose-ranging PK, safety and efficacy study in pediatric subjects 6 to <18 years of age with moderate to severe psoriasis (with ixekizumab exposure of at least one year).\", \"citations\": [{\"quote\": \"3049-1 Conduct a dose-ranging Pharmacokinetics (PK), Safety and Efficacy Study in pediatric subjects 6 to &lt;18 years of age with moderate to severe psoriasis (with a duration of exposure to ixekizumab of at least one year).\", \"doc_id\": \"b49ca5c9-0ae2-566d-8cbd-854ad39c1efc\", \"line\": 34}]}},\n    {\"type\": \"PMR\", \"requirement\": {\"text\": \"3049-2: Retrospective cohort study using administrative databases to identify pregnancy outcomes in women exposed to ixekizumab versus a non-ixekizumab systemic medication cohort.\", \"citations\": [{\"quote\": \"3049-2 Conduct a retrospective cohort study using administrative databases to identify pregnancy outcomes in a cohort of women exposed to ixekizumab and a non-ixekizumab systemic medication exposure cohort.\", \"doc_id\": \"b49ca5c9-0ae2-566d-8cbd-854ad39c1efc\", \"line\": 46}]}},\n    {\"type\": \"PMR\", \"requirement\": {\"text\": \"3049-3: Prospective registry-based observational exposure cohort study comparing maternal, fetal, and infant outcomes of women exposed to ixekizumab during pregnancy to an unexposed control population.\", \"citations\": [{\"quote\": \"3049-3 Conduct a prospective registry-based observational exposure cohort study that compares the maternal, fetal, and infant outcomes of women exposed to ixekizumab during pregnancy to an unexposed control population.\", \"doc_id\": \"b49ca5c9-0ae2-566d-8cbd-854ad39c1efc\", \"line\": 49}]}},\n    {\"type\": \"PMR\", \"requirement\": {\"text\": \"3049-4: Prospective observational study of long-term safety of ixekizumab vs other therapies in adults with moderate-to-severe plaque psoriasis, primary outcome malignancy.\", \"citations\": [{\"quote\": \"3049-4 Conduct a prospective, observational study to assess the long-term safety of ixekizumab compared to other therapies used in the treatment of adults with moderate-to-severe plaque psoriasis who are candidates for systemic therapy or phototherapy in the course of actual clinical care. The study's primary outcome is malignancy.\", \"doc_id\": \"b49ca5c9-0ae2-566d-8cbd-854ad39c1efc\", \"line\": 52}]}},\n    {\"type\": \"PMC\", \"requirement\": {\"text\": \"3049-5: Clinical study to assess whether ixekizumab alters the metabolism or pharmacokinetics of CYP substrates in psoriasis patients.\", \"citations\": [{\"quote\": \"3049-5 Conduct a clinical study to assess whether ixekizumab alters the metabolism or pharmacokinetics of CYP substrates in psoriasis patients treated with ixekizumab.\", \"doc_id\": \"b49ca5c9-0ae2-566d-8cbd-854ad39c1efc\", \"line\": 61}]}},\n    {\"type\": \"PMC\", \"requirement\": {\"text\": \"3049-6: Perform a repeat microbial retention study using a suitable surrogate solution (or a modified process/formulation/reduced exposure time).\", \"citations\": [{\"quote\": \"3049-6 Perform a repeat microbial retention study for the [REDACTED] (b)(4) using a suitable surrogate solution.\", \"doc_id\": \"b49ca5c9-0ae2-566d-8cbd-854ad39c1efc\", \"line\": 67}]}},\n    {\"type\": \"PMC\", \"requirement\": {\"text\": \"3049-7: Provide data from two additional commercial drug product batches to support the maximum hold time for pooled drug substance and drug product.\", \"citations\": [{\"quote\": \"3049-7 Provide data from two additional commercial drug product batches to support the maximum hold time for pooled drug substance.\", \"doc_id\": \"b49ca5c9-0ae2-566d-8cbd-854ad89c1efc\".replace(\"89c1efc\",\"3041efc\"), \"line\": 70}]}}\n  ],\n  \"crl_history\": {\n    \"prior_crl\": false,\n    \"date\": null,\n    \"basis\": null\n  },\n  \"approval_program\": {\n    \"accelerated_approval\": {\n      \"present\": false,\n      \"surrogate_endpoint\": null,\n      \"confirmatory_requirement\": null\n    },\n    \"breakthrough_therapy\": {\"present\": false, \"basis\": null},\n    \"fast_track\": {\"present\": false, \"basis\": null},\n    \"orphan_drug\": {\"present\": false, \"orphan_indication\": null},\n    \"priority_review\": {\"present\": false, \"basis\": null},\n    \"qidp\": {\"present\": false, \"basis\": null},\n    \"rmat\": {\"present\": false, \"basis\": null},\n    \"summary\": {\n      \"text\": \"Standard BLA under section 351(a) of the PHS Act / 505(b)(1), received March 23, 2015 with a PDUFA goal date of March 23, 2016; approved on the first cycle based on three adequate and well-controlled Phase 3 trials. No advisory committee was convened as this second-in-class IL-17A antagonist did not present novel issues.\",\n      \"citations\": [\n        {\"quote\": \"TALTZ (ixekizumab) injection is a solution, intended for subcutaneous administration via prefilled syringe or autoinjector, for which the applicant seeks licensure under Section 351 of the PHS Act and approval under section 505(b)(1) of the Federal Food, Drug and Cosmetic Act for the indication of treatment of adults with moderate-to-severe plaque psoriasis who are candidates for systemic therapy \", \"doc_id\": \"65597e08-4ad8-5b94-8828-07e88ecce742\", \"line\": 22},\n        {\"quote\": \"Date of Submission\\t23 Mar 2015\\nPDUFA Goal Date\\t23 Mar 2016\", \"doc_id\": \"65597e08-4ad8-5b94-8828-07e88ecce742\", \"line\": 5},\n        {\"quote\": \"No advisory committee meeting was held, as the application for this second-in-class IL17A antagonist did not present novel issues which merited advisory committee input.\", \"doc_id\": \"65597e08-4ad8-5b94-8828-07e88ecce742\", \"line\": 88}\n      ]\n    }\n  }\n}",
