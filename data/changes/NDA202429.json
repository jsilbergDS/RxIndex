      "efficacy_supp": {
        "submission_number": 9,
        "class_code": "EFFICACY",
        "approval_date": "2016-08-31",
        "description": {
          "text": "Updated Clinical Studies with anti-tumor activity data for BRAF V600E mutation-positive melanoma with brain metastases, plus PLLR labeling changes",
          "citations": [
            {
              "quote": "This Prior Approval supplemental new drug application proposes to update the Clinical Studies section to include information from Study MO25743 on the anti-tumor activity of vemurafenib in the treatment of patients with BRAF V600E mutation-positive melanoma with brain metastases; to incorporate revisions to Warnings and Precautions section 5.9, Use in Specific Population sections 8.1, 8.2 and 8.3, Patient Counseling, Section 17, of the package insert, and to the Medication Guide for compliance with Pregnancy and Lactation Labeling Rule (PLLRR); and to include editorial changes to Clinical Pharmacology, section 12.1, and Nonclinical Toxicology, sections 13.1 and 13.2, of the package insert.",
              "doc_id": "b130bb9b-0338-55a3-ad68-47b95b0aea77",
              "line": 6
            }
          ]
        },
