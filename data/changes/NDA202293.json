        "approval_date": "2017-10-20",
        "description": {
          "text": "Added efficacy data for concomitant initiation of exenatide once weekly plus dapagliflozin in type 2 diabetes inadequately controlled on metformin",
          "citations": [
            {
              "quote": "This Prior Approval supplemental new drug application proposes to include the efficacy data from the following exenatide dapagliflozin clinical study: DURATION 8 (D5553C0003), *A 28-week, multi-centre, randomised, double-blind, active-controlled, phase 3 study with a 24-week extension phase followed by a 52-week extension phase to evaluate the efficacy and safety of concomitant initiation of exenatide once weekly 2 mg and dapagliflozin once daily 10 mg compared to exenatide once weekly 2 mg alone and dapagliflozin once daily 10 mg alone in patients with type 2 diabetes mellitus (T2DM) who have inadequate glycemic control on metformin.*",
              "doc_id": "fa46d54a-a34c-58ad-9f58-daa69305da0c",
              "line": 6
            }
          ]
        },
