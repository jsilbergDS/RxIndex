    {
      "date": "4/2024",
      "classes": [
        "EFFICACY"
      ],
      "efficacy_supp": {
        "submission_number": 89,
        "class_code": "EFFICACY",
        "approval_date": "2024-04-30",
        "description": {
          "text": "Expanded pediatric CKD anemia indication to patients 3 months to 17 years, on and not on dialysis, converting from another ESA, and added subcutaneous route of administration",
          "citations": [
            {
              "quote": "This Prior Approval sBLA provides for extension of the indication for the treatment of anemia associated with chronic kidney disease (CKD) in pediatric patients 3 months to 17 years of age on dialysis and not on dialysis who are converting from another erythropoiesis-stimulating agent (ESA) after their hemoglobin level was stabilized with an ESA. Previously, the indication was approved for pediatric patients 5 to 17 years of age with CKD on hemodialysis. Additionally, this Prior Approval sBLA provides for a subcutaneous route of administration for pediatric patients. Previously, the pediatric patients could only use the intravenous route of administration.",
              "doc_id": "7f486389-41fc-5b60-88bb-127b138ec040",
              "line": 6
            }
          ]
        },
        "review_url": null,
