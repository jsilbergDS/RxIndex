      "efficacy_supp": {
        "submission_number": 19,
        "class_code": "EFFICACY",
        "approval_date": "2024-06-21",
        "description": {
          "text": "Converted Sirturo (bedaquiline) from accelerated approval to full approval for MDR-TB combination therapy",
          "citations": [
            {
              "quote": "This Prior Approval supplemental new drug application provides for conversion of Sirturo from accelerated approval to full approval. Sirturo is indicated as part of combination therapy in the treatment of adult and pediatric patients (5 years and older and weighing at least 15 kg) with pulmonary tuberculosis (TB) due to *Mycobacterium tuberculosis* resistant to at least rifampin and isoniazid. The following sections of the prescribing information (PI) have been revised: **HIGHLIGHTS OF PRESCRIBING INFORMATION**, **BOXED WARNING**, **INDICATIONS AND USAGE (1)**, **DOSAGE AND ADMINISTRATION (2)**, **WARNINGS AND PRECAUTIONS (5)**, **ADVERSE REACTIONS (6)**, **DRUG INTERACTIONS (7)**, **CLINICAL PHARMACOLOGY (12)**, **CLINICAL STUDIES (14)** and **PATIENT COUNSELING INFORMATION (17)**.",
              "doc_id": "c30160d6-18aa-5ed8-909b-f48bdf372468",
              "line": 6
            }
          ]
        },
        "review_url": null,
        "letter_url": "https://www.accessdata.fda.gov/drugsatfda_docs/appletter/2024/204384Orig1s019ltr.pdf",
