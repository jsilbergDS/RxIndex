      "efficacy_supp": {
        "submission_number": 3,
        "class_code": "EFFICACY",
        "approval_date": "2018-10-19",
        "description": {
          "text": "Converted dosing from weight-based 10 mg/kg every two weeks to a flat dose of 800 mg every two weeks",
          "citations": [
            {
              "quote": "This Prior Approval Supplemental Biologics Application provides for updates to the U.S. Prescribing Information (USPI) to the Dosage and Administration, Recommended Dosage subsection (2.2) to convert from a weight-based dose regimen of 10 mg/kg every two weeks to a flat dose regimen of 800 mg every two weeks; and to the Clinical Pharmacology section to add a new Pharmacodynamics (12.2) subsection and to revise the Pharmacokinetics (12.3) subsection to support this new dosage regimen.",
              "doc_id": "db3f224b-9837-53a0-8e07-1f36b03f2ada",
              "line": 7
