      "efficacy_supp": {
        "submission_number": 32,
        "class_code": "EFFICACY",
        "approval_date": "2016-01-29",
        "description": {
          "text": "Converted accelerated approval to full approval for SEGA with TSC by confirming clinical benefit",
          "citations": [
            {
              "quote": "These Prior Approval supplemental new drug applications confirm the clinical benefit of AFINITOR and AFINITOR DISPERZ for the treatment of pediatric and adult patients with tuberous sclerosis complex (TSC) who have subependymal giant cell astrocytoma (SEGA) that requires therapeutic intervention but cannot be curatively resected, approved on October 29, 2010, for AFINITOR and approved on August 29, 2012, for AFINITOR DISPERZ under the provisions of 21 CFR 314.510. The INDICATIONS AND USAGE, Subependymal Giant Cell Astrocytoma (SEGA) with Tuberous Sclerosis Complex (TSC) subsection has been revised to remove the following language (italicized): *The effectiveness of AFINITOR Tablets and AFINITOR DISPERZ is based on demonstration of durable objective response, as evidenced by reduction in SEGA tumor volume. Improvement in disease-related symptoms and overall survival in patients with SEGA and TSC has not been demonstrated.* In addition, the ADVERSE REACTIONS, USE IN SPECIFIC POPULATIONS, Pediatric Use, and CLINICAL STUDIES sections of labeling have been revised with the results of the clinical trial verifying the clinical benefit of AFINITOR and AFINITOR DISPERZ in this population.",
              "doc_id": "42073958-6420-5aab-9b18-f049d90ae9b2",
              "line": 6
            }
          ]
        },
        "review_url": null,
        "letter_url": "http://www.accessdata.fda.gov/drugsatfda_docs/appletter/2016/022334Orig1s032,203985Orig1s010ltr.pdf",
