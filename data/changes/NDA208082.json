        "approval_date": "2021-06-24",
        "description": {
          "text": "Added pediatric use labeling (section 8.4) for patients age 6 to 16 with Tourette Syndrome based on Written Request studies",
          "citations": [
            {
              "quote": "This Prior Approval supplemental new drug application provides for labeling changes to section 8.4 (Pediatric Use), obtained from studies completed in response to our Written Request issued January 8, 2020, regarding the use of deutetrabenazine in patients age 6 to 16 for the treatment of Tourette Syndrome. These changes include description of studies conducted, relevant safety information, and description of juvenile animal toxicity data.",
              "doc_id": "a63c189a-8cd7-5e9a-8f19-c337f8101fd5",
              "line": 6
            }
          ]
