      "efficacy_supp": {
        "submission_number": 16,
        "class_code": "EFFICACY",
        "approval_date": "2026-03-27",
        "description": {
          "text": "Added a higher dosing regimen with two new strength presentations (28 mg/5 mL and 50 mg/5 mL)",
          "citations": [
            {
              "quote": "This Prior Approval sNDA provides for revisions throughout the Prescribing Information (PI) regarding a completed clinical study [Study 4 (NCT04089566)], which provides an additional higher dosing regimen. Two corresponding additional strength presentations [28 mg/5 mL (5.6 mg/mL) and 50 mg/5 mL (10 mg/mL)] are included for administration of the new dosing regimen. This sNDA also includes revisions to the Pediatric Use subsection (8.4) of the PI to include results from a combined 6- and 13-week toxicity study in juvenile monkeys.",
              "doc_id": "0d2bdb67-5acf-595a-b203-162ef897da6c",
              "line": 10
            }
          ]
        },
