      "efficacy_supp": {
        "submission_number": 15,
        "class_code": "EFFICACY",
        "approval_date": "2025-11-20",
        "description": {
          "text": "Added pediatric safety and efficacy updates and alternative administration instructions in response to pediatric exclusivity written request",
          "citations": [
            {
              "quote": "These Prior Approval sNDAs provide for a request for pediatric exclusivity in response to the June 22, 2023, Pediatric Written Request, and provides pediatric safety and efficacy updates (section 14 CLINICAL STUDIES) of the U.S. Prescribing Information labeling. Additional updates include alternative administration instructions for patients unable to swallow capsules or tablets, edits to Section 5.6 (Hypersensitivity in WARNINGS AND PRECAUTIONS), dose modifications for hypersensitivity reactions, safety findings of Stevens Johnson Syndrome in post-marketing experience, and the addition of patient Instructions for Use (IFU) labeling.",
              "doc_id": "c37aab9b-4ab9-5272-be0a-5da2303818be",
              "line": 6
            }
          ]
