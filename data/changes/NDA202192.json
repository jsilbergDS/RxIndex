        "EFFICACY"
      ],
      "efficacy_supp": {
        "submission_number": 6,
        "class_code": "EFFICACY",
        "approval_date": "2014-07-25",
        "description": {
          "text": "Labeling update adding 3-year median follow-up overall survival data and dose titration/modification information (no new indication)",
          "citations": [
            {
              "quote": "This Prior Approval supplemental new drug application provides for updates to the package insert that include overall survival data based on 3 year median follow-up from the two randomized Phase 3 studies, INCB 18424-351 and INCB 18424-352 (CINC424A2352), and dose titration information based on experience in these 2 studies. In addition, the Dosage and Administration section has been updated to include dose modifications for patients who are on a stable dose of Jakafi\u00ae and then start treatment with a strong CYP3A4 inhibitor or fluconazole. Lastly, additional text has been added to the Warnings and Precautions Sections 5.2 and 5.3.",
              "doc_id": "a8fcca63-2380-51fc-9bb7-6870e5927dc7",
              "line": 7
            }
          ]
        },
