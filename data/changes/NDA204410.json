        "approval_date": "2025-02-28",
        "description": {
          "text": "Updated Pediatric Use labeling based on pediatric PAH study (TOMORROW) in children with pulmonary arterial hypertension",
          "citations": [
            {
              "quote": "This Prior Approval supplemental new drug application provides for changes to labeling (Section 8.4, Pediatric Use) based on the results of Protocol #AC-055-312, titled \"A multicenter, open-label, randomized study with single-arm extension period to assess the pharmacokinetics, safety, and efficacy of macitentan versus standard of care in children with pulmonary arterial hypertension\" (TOMORROW). This sNDA was submitted in response to a pediatric Written Request under the Best Pharmaceuticals for Children Act (BPCA).",
              "doc_id": "7621a87a-5b95-5d36-841e-2896c6eca094",
              "line": 5
            }
