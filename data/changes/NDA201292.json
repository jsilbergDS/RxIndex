      "efficacy_supp": {
        "submission_number": 14,
        "class_code": "EFFICACY",
        "approval_date": "2018-01-12",
        "description": {
          "text": "Expanded indication to include metastatic NSCLC with non-resistant EGFR mutations beyond exon 19 deletions or exon 21 (L858R)",
          "citations": [
            {
              "quote": "This Prior Approval supplemental new drug application provides updates to expand the approved indication to include treatment of patients with metastatic non-small cell lung cancer (NSCLC) whose tumors have non-resistant epidermal growth factor receptor (EGFR) mutations as detected by an FDA-approved test, which includes additional mutations other than EGFR exon 19 deletions or exon 21 (L858R) substitution mutations. In addition, the Limitation of Use was modified for the approved indication to denote that safety and efficacy have not been established in patients whose tumors have resistant EGFR mutations.",
              "doc_id": "d0b46445-504d-5e9a-b948-dda0895c906f",
              "line": 6
            }
          ]
        },
