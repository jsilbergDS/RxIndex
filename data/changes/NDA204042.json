      "efficacy_supp": {
        "submission_number": 32,
        "class_code": "EFFICACY",
        "approval_date": "2019-09-27",
        "description": {
          "text": "Added indication to reduce the risk of ESKD, doubling of serum creatinine, CV death, and hospitalization for heart failure in adults with type 2 diabetes mellitus and diabetic nephropathy with albuminuria > 300 mg/day",
          "citations": [
            {
              "quote": "The review team agrees that the application provides substantial evidence of canagliflozin's effectiveness in reducing the risk of end-stage kidney disease (ESKD), doubling of serum creatinine, cardiovascular (CV) death, and hospitalization for heart failure in adults with type 2 diabetes mellitus and diabetic nephropathy with albuminuria &gt; 300 mg/day. The application will be approved for this new indication.",
              "doc_id": "270cf81a-f6a5-5c7d-b4d0-c433fea974e2",
              "line": 25
            }
          ]
        },
