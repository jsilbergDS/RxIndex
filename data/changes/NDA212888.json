      "efficacy_supp": {
        "submission_number": 1,
        "class_code": "EFFICACY",
        "approval_date": "2022-01-31",
        "description": {
          "text": "Added new every-2-month gluteal intramuscular dosing regimen of Cabenuva as a complete regimen for HIV-1 treatment in virologically suppressed adults",
          "citations": [
            {
              "quote": "- New dosage regimen of every-2-month gluteal intramuscular injections of Cabenuva as a complete regimen for the treatment of HIV-1 infection in adults to replace the current antiretroviral regimen in those who are virologically suppressed (HIV-1 RNA &lt;50 copies per mL) on a stable antiretroviral regimen with no history of treatment failure and with no known or suspected resistance to either cabotegravir or rilpivirine\n- Updates to ADVERSE REACTIONS, Clinical Trials Experience to include additional safety data as well as injection-associated adverse reactions based on week 48 data from ATLAS-2M\n- Updates to CLINICAL PHARMACOLOGY, Pharmacokinetics and Microbiology section of the labeling with additional pharmacokinetic data for the every-2-month dosage regimen as well as virologic resistance data based on ATLAS-2M data\n- Updates to CLINICAL STUDIES, Clinical Trials in Adults for Treatment of HIV-1 infection with new clinical trial data to support the new dosage regimen\n- Updates to PATIENT COUNSELING INFORMATION to provide advice on Cabenuva being administered as a every-2-month dosage regimen after use of lead-in therapy with oral Vocabria and Edurant",
              "doc_id": "f5332042-bc6d-5fde-91b9-c66cdce0d994",
              "line": 7
            }
          ]
        },
        "review_url": null,
        "letter_url": "https://www.accessdata.fda.gov/drugsatfda_docs/appletter/2022/212888Orig1s001ltr.pdf",
