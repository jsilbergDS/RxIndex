        "description": {
          "text": "Added indication for hospital-acquired/ventilator-associated bacterial pneumonia (HABP/VABP) caused by susceptible Gram-negative organisms in patients 18 years or older",
          "citations": [
            {
              "quote": "This Prior Approval supplemental new drug application provides evidence for the efficacy and safety of AVYCAZ in the treatment of patients with hospital-acquired bacterial pneumonia/ventilator-associated bacterial pneumonia (HABP/VABP) caused by the following susceptible Gram-negative microorganisms: *Klebsiella pneumoniae*, *Enterobacter cloacae*, *Escherichia coli*, *Serratia marcescens*, *Proteus mirabilis*, *Pseudomonas aeruginosa*, and *Haemophilus influenzae* in patients 18 years or older.",
              "doc_id": "eba5ce44-fbd0-5137-8d70-1be73981fd0a",
              "line": 6
            }
