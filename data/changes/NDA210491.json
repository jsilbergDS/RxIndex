        "approval_date": "2019-06-21",
        "description": {
          "text": "Expanded indication to cystic fibrosis patients aged 6 to less than 12 years homozygous for F508del or with at least one CFTR mutation responsive to tezacaftor/ivacaftor",
          "citations": [
            {
              "quote": "This Prior Approval supplemental new drug application provides for expansion of the indication for the use of tezacaftor/ivacaftor 50 mg/75 mg once daily followed by ivacaftor 75 mg 12 hours later for patients &lt; 30 kg, and tezacaftor/ivacaftor 100 mg/150 mg once daily followed by ivacaftor 150 mg 12 hours later for patients \u2265 30 kg, for the treatment of cystic fibrosis in patients aged 6 to less than 12 years old who are homozygous for the *F508del* mutation or who have at least one mutation in the cystic fibrosis transmembrane conductance regulator (*CFTR*) gene that is responsive to tezacaftor/ivacaftor based on *in vitro* data and/or clinical evidence.",
              "doc_id": "fe1a8d62-d8cf-51cc-8d25-355a8ae9f86b",
              "line": 7
            }
          ]
        },
