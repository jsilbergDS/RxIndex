    {
      "date": "2/2016",
      "classes": [
        "EFFICACY"
      ],
      "efficacy_supp": {
        "submission_number": 13,
        "class_code": "EFFICACY",
        "approval_date": "2016-02-26",
        "description": {
          "text": "Added indication for obinutuzumab (Gazyva) in combination with bendamustine followed by Gazyva monotherapy for follicular lymphoma relapsed/refractory to a rituximab-containing regimen",
          "citations": [
            {
              "quote": "This Prior Approval supplemental biologics application provides for a new indication, which is Gazyva\u00ae, in combination with bendamustine followed by Gazyva\u00ae monotherapy, is indicated for the treatment of patients with follicular lymphoma (FL) who relapsed after, or are refractory to, a rituximab-containing regimen. The new indication is based on efficacy and safety data from the primary analysis of Study GAO4753g/GO01297 (GADOLIN), which evaluated obinutuzumab in combination with bendamustine followed by obinutuzumab monotherapy, compared with bendamustine alone in patients with indolent non-Hodgkin lymphoma (iNHL) who did not respond to or progressed during or after treatment with rituximab or a rituximab-containing regimen.",
              "doc_id": "831dd1c6-c467-5093-92cf-acb71cfc5e01",
              "line": 6
            }
          ]
        },
        "review_url": null,
        "letter_url": "https://www.accessdata.fda.gov/drugsatfda_docs/appletter/2016/125486Orig1s013ltr.pdf",
