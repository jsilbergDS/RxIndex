      "efficacy_supp": {
        "submission_number": 15,
        "class_code": "EFFICACY",
        "approval_date": "2019-08-09",
        "description": {
          "text": "Labeling update (Sections 6 and 14) adding results from the DU176b-D-U311 study of edoxaban in cancer-associated venous thromboembolism",
          "citations": [
            {
              "quote": "This Prior Approval supplemental new drug application provides for an update in the United States Prescribing Information (USPI) Section 6 Adverse Reactions and Section 14 Clinical Studies with the results from study DU176b-D-U311, entitled, \"A Phase 3b, prospective, randomized, open-label, blind evaluator (PROBE) study evaluating the efficacy and safety of low molecular weight (LMW) heparin/edoxaban versus dalteparin in venous thromboembolism associated with cancer.\" In addition, inclusion of the terms thrombocytopenia, angioedema, hypersensitivity, and urticaria in Subsection 6.2 Postmarketing Experience, and an update in Subsection 7.1 to include selective serotonin reuptake inhibitors (SSRIs)/serotonin norepinephrine reuptake inhibitors (SNRIs).",
              "doc_id": "1fc61409-6473-5cab-b803-efe6339b0992",
              "line": 5
            }
          ]
        },
