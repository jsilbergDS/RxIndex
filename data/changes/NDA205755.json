      "efficacy_supp": {
        "submission_number": 9,
        "class_code": "EFFICACY",
        "approval_date": "2017-05-26",
        "description": {
          "text": "Converted accelerated approval to full approval for ALK-positive metastatic NSCLC, verifying clinical benefit after crizotinib",
          "citations": [
            {
              "quote": "This Prior Approval supplemental new drug application provides for a new indication for the treatment of patients with metastatic non-small cell lung cancer (NSCLC) whose tumors are anaplastic lymphoma kinase (ALK)-positive as detected by an FDA-approved test, based on the results of Study CLDK378A2301, which verified the clinical benefit of Zykadia for the treatment of patients with anaplastic lymphoma kinase (ALK)-positive, metastatic, NSCLC who have progressed on or are intolerant to crizotinib and fulfilled PMR 2146-1 cited in the April 29, 2014, approval letter for NDA 205755.",
              "doc_id": "132b6b14-5f89-5161-9fb4-f01fda9c510c",
              "line": 6
            }
          ]
        },
