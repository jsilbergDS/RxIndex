        "approval_date": "2026-02-20",
        "description": {
          "text": "Extended existing indications to pediatric patients under 2 years of age, including term neonates",
          "citations": [
            {
              "quote": "This Prior Approval supplemental new drug application updates the U.S. Prescribing Information to include an extension of the existing Elucirem indications to pediatric patients &lt; 2 years of age, including term neonates. In addition, this supplement provides for revisions to subsection 8.1 Pregnancy to reflect clinical experience regarding the risk of in utero exposure to gadolinium-based contrast agents (GBCAs) based on a review of scientific literature.",
              "doc_id": "936c8801-bece-5f80-9a46-97ec078d8d2e",
              "line": 7
            }
