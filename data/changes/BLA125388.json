        "approval_date": "2025-02-11",
        "description": {
          "text": "Added new indication: brentuximab vedotin in combination with lenalidomide and a rituximab product for relapsed or refractory large B-cell lymphoma after two or more lines of therapy in patients ineligible for auto-HSCT or CAR T-cell therapy",
          "citations": [
            {
              "quote": "This Prior Approval supplemental biologics license application provides for a new indication: Adcetris (brentuximab vedotin) in combination with lenalidomide and a rituximab product for the treatment of adult patients with relapsed or refractory large B-cell lymphoma (LBCL), including diffuse large B-cell lymphoma (DLBCL) not otherwise specified (NOS), DLBCL arising from indolent lymphoma, or high-grade B-cell lymphoma (HGBL), after two or more lines of systemic therapy who are not eligible for autologous hematopoietic stem cell transplantation (auto-HSCT) or chimeric antigen receptor (CAR) T-cell therapy.",
              "doc_id": "a170de0a-cb1c-5b69-b0ce-e03c4f1ef9b4",
              "line": 6
            }
          ]
        },
