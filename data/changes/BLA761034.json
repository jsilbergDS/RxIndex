        "approval_date": "2017-04-17",
        "description": {
          "text": "Added indication for cisplatin-ineligible patients with locally advanced or metastatic urothelial carcinoma",
          "citations": [
            {
              "quote": "The safety of TECENTRIQ was evaluated in Study 4, a multicenter, open-label, single-arm trial that included 119 patients with locally advanced or metastatic urothelial carcinoma who were ineligible for cisplatin-containing chemotherapy and were either previously untreated or had disease progression at least 12 months after neoadjuvant or adjuvant chemotherapy [see *Clinical Studies* (14.1)]. Patients received 1200 mg of TECENTRIQ intravenously every 3 weeks until either unacceptable toxicity or disease progression. The median duration of exposure was 15.0 weeks (range 0, 87 weeks).",
              "doc_id": "ab9ae74b-b4ee-5225-a10e-998327fac04e",
              "line": 147
            }
          ]
        },
