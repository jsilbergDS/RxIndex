      "efficacy_supp": {
        "submission_number": 207,
        "class_code": "EFFICACY",
        "approval_date": "2017-06-29",
        "description": {
          "text": "Modified the indicated population for both metastatic colorectal cancer indications from wild-type KRAS to wild-type RAS (wild-type in both KRAS and NRAS)",
          "citations": [
            {
              "quote": "- To modify the indicated population for both of the indications from the treatment of patients with wild-type *KRAS* (exon 2 codons 12 or 13) metastatic colorectal cancer as determined by an FDA-approved test to the treatment of patients with wild-type *RAS* (defined as wild-type in both *KRAS* and *NRAS*) metastatic colorectal cancer as determined by an FDA-approved test for:As first-line therapy in combination with FOLFOX.\n- As monotherapy following disease progression after prior treatment with fluoropyrimidine-, oxaliplatin-, and irinotecan-containing chemotherapy.",
              "doc_id": "9c07d733-374e-52cb-af85-562d1e017240",
              "line": 7
            }
          ]
        },
