        "EFFICACY"
      ],
      "efficacy_supp": {
        "submission_number": 213,
        "class_code": "EFFICACY",
        "approval_date": "2025-01-16",
        "description": {
          "text": "Added indication for Vectibix in combination with sotorasib for KRAS G12C-mutated mCRC after prior fluoropyrimidine-, oxaliplatin-, and irinotecan-based chemotherapy",
          "citations": [
            {
              "quote": "This Prior Approval supplemental biologics license application adds a new indication of Vectibix, in combination with sotorasib, for the treatment of adult patients with KRAS G12C-mutated metastatic colorectal cancer (mCRC), as determined by an FDA approved test, who have received prior treatment with fluoropyrimidine-, oxaliplatin-, and irinotecan-based chemotherapy. It also adds the following statement to the Limitations of Use: \"Vectibix is not indicated for the treatment of patients with RAS-mutant mCRC unless used in combination with sotorasib in KRAS G12C-mutated mCRC.\"",
              "doc_id": "3ed2c460-0672-5556-a926-ef42cc2a5d1e",
              "line": 11
            }
          ]
        },
