      "efficacy_supp": {
        "submission_number": 28,
        "class_code": "EFFICACY",
        "approval_date": "2024-06-14",
        "description": {
          "text": "Pediatric exclusivity determination supplement fulfilling a Written Request for pediatric information in patients birth to <17 years for management of moderate to severe acute pain",
          "citations": [
            {
              "quote": "This Prior Approval supplemental new drug application, containing a request for Pediatric Exclusivity Determination, was submitted to fulfill the requirements of a Written Request issued by the Agency on July 8, 2013, with amendments issued on August 14, 2014, June 22, 2015, July 10, 2019, December 2, 2021, and November 3, 2023, to obtain pediatric information on Nucynta (tapentadol) from birth (i.e., neonates) to less than 17 years of age for the management of moderate to severe acute pain. Related labeling changes were previously incorporated in the approval letter for sNDA-024 dated July 3, 2023.",
              "doc_id": "f384a618-d70f-5402-a8db-c7ff38bb43f9",
