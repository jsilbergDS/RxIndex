        "class_code": "EFFICACY",
        "approval_date": "2023-07-03",
        "description": {
          "text": "Added management of moderate to severe acute pain in pediatric patients ages six to less than 17 years",
          "citations": [
            {
              "quote": "This Prior Approval supplemental new drug application provides for labeling revisions to include pharmacokinetic, efficacy, and safety data of Nucynta tablets for the management of moderate to severe acute pain in pediatric patients ages six years to less than 17 years. Additionally, the safety labeling changes (SLC) included in our SLC Notification letter dated April 13, 2023, were incorporated to reflect the new safety information. (b)(14)",
              "doc_id": "1269edef-7ed3-5b5e-84a3-d8ba7220bfaf",
              "line": 7
            }
          ]
        },
