      "efficacy_supp": {
        "submission_number": 23,
        "class_code": "EFFICACY",
        "approval_date": "2019-01-15",
        "description": {
          "text": "Added efficacy and safety data for Trulicity in combination with an SGLT2 inhibitor (with or without metformin) in type 2 diabetes mellitus",
          "citations": [
            {
              "quote": "This Prior Approval supplemental biologics application provides for the following changes for Trulicity (dulaglutide) injection: the addition of efficacy and safety information to the Prescribing Information on the use of Trulicity in type 2 diabetes mellitus (T2DM) patients based on the clinical data from the Phase 3 Study GBGE (AWARD-10), a 24-week, Phase 3b, randomized, double-blind, placebo-controlled, parallel-arm, multicenter trial that investigated the effects of the addition of once-weekly dulaglutide 1.5 mg or 0.75 mg to an SGLT2 inhibitor, with or without concomitant use of metformin, on glycemic control and safety in patients with inadequately controlled T2DM.",
              "doc_id": "476d326c-e78a-53f0-8a46-03cb141a19dc",
              "line": 6
            }
          ]
        },
