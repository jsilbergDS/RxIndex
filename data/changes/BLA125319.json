      ],
      "efficacy_supp": {
        "submission_number": 97,
        "class_code": "EFFICACY",
        "approval_date": "2020-06-16",
        "description": {
          "text": "Expanded indication to include adults with active Adult-Onset Still's Disease (AOSD)",
          "citations": [
            {
              "quote": "This Prior Approval supplemental biologics application provides for expansion of the approved indication for the treatment of Active Systemic Juvenile Idiopathic Arthritis (SJIA) in patients aged 2 years and older, to include the new population of patients with active Adult-Onset Still's Disease (AOSD). Both, SJIA and AOSD, are referred to as Still's Disease. With the approval of this Prior Approval supplemental biologics application, canakinumab is indicated for the treatment of active Still's Disease, including AOSD and SJIA in patients aged 2 years and older.",
              "doc_id": "fc320b7b-6c96-5d59-abe9-dc6d2aba5468",
              "line": 7
            }
          ]
        },
