        "description": {
          "text": "Removed limitations of use and added indication for selection of patients indicated for amyloid beta-directed therapy; added quantitative image analysis",
          "citations": [
            {
              "quote": "This Prior Approval supplemental new drug application provides for changes to the INDICATIONS AND USAGE section of the prescribing information by removing the limitations of use and adding a new indication, specifically, use for selection of patients who are indicated for amyloid beta-directed therapy as described in the prescribing information of the therapeutic products. In addition, the use of quantitative image analysis is added to the Image Display and Interpretation subsection of the DOSAGE AND ADMINISTRATION section.",
              "doc_id": "a15dbbac-7374-5067-9040-0209853807ad",
              "line": 5
            }
