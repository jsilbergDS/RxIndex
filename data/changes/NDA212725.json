      "efficacy_supp": {
        "submission_number": 9,
        "class_code": "EFFICACY",
        "approval_date": "2023-10-20",
        "description": {
          "text": "Expanded to pediatric patients older than 1 month of age with NTRK gene fusion solid tumors and added a new oral suspension route/method of administration for capsules",
          "citations": [
            {
              "quote": "This Prior Approval sNDA provides for treatment of adult and pediatric patients older than 1 month of age with solid tumors that have a neurotrophic tyrosine receptor kinase (NTRK) gene fusion without a known acquired resistance mutation as detected by an FDA-approved test, are metastatic or where surgical resection is likely to result in severe morbidity, and have progressed following treatment or have no satisfactory alternative therapy, and for a new route and method of administration for capsules prepared as an oral suspension.",
              "doc_id": "1360edb6-717c-538e-90a9-43f84daa2052",
              "line": 5
            }
          ]
        },
